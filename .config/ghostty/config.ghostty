term = xterm-256color

background-opacity = 0.7
font-family = Hack Nerd Font Mono
font-size = 14
clipboard-read = allow
clipboard-write = allow
window-padding-x = 5
window-padding-y = 10
window-padding-balance = true
window-decoration = false

keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+minus=new_split:down

keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right

# Colors
background = #000000
foreground = #BDFFFD

palette = 0=#45475a
palette = 1=#24d791
palette = 2=#5bc953
palette = 3=#c5b253
palette = 4=#29dc6d
palette = 5=#5d9d92
palette = 6=#24bac1
palette = 7=#2bc84c

palette = 8=#585b70
palette = 9=#00ff9b
palette = 10=#9afe9a
palette = 11=#ffd16c
palette = 12=#49ff8e
palette = 13=#10ffdc
palette = 14=#20d0b3
palette = 15=#00e3ff
